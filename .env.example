# Copie este arquivo para .env.local e preencha. NUNCA commite o .env.local.
# Credenciais do app em https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Preenchido automaticamente por `npm run strava:auth` (não precisa digitar).
STRAVA_REFRESH_TOKEN=

# Atividades marcadas como "Somente eu" entram por padrão (precisa do escopo activity:read_all).
# Para deixá-las de fora, descomente: 
# STRAVA_INCLUDE_PRIVATE=false

# Opcional: escrever de volta no Strava (precisa do escopo activity:write: rode "npm.cmd run strava:auth -- --write").
# Qualquer valor liga. REGRAS fixas no código (ver README): nunca mexe em atividade com título que você escreveu;
# só bike, corrida e musculação; só mais de 15 minutos; o título vem do tipo do treino e da série.
# STRAVA_LABEL_WRITE=smart

# Sincronização instantânea (webhook do Strava). Gerado por `npm run strava:webhook -- prepare`.
# Cadastre o mesmo valor na Vercel. Veja o README.
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Banco de dados (Supabase). Ver supabase/schema.sql e o README.
# Use a SECRET key (só no servidor). Nunca use a chave publishable/anon aqui.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Optional: written AI analysis of each new workout (Lab > Workout analysis) ---
# Get a key at https://console.anthropic.com and set it ONLY here (.env.local) and in Vercel, never in the code.
ANTHROPIC_API_KEY=
# Modelos (os padrões já gastam o mínimo; só mexa se quiser outro):
# LAB_AI_MODEL=claude-haiku-5-5      # análise de cada treino
# LAB_AI_EFFORT=medium               # low | medium | high
# LAB_FORM_MODEL=claude-sonnet-5-5   # comentário diário de forma e fadiga (esforço baixo)

# Planejador escondido (/lab#planner-hq): só quem tem esta chave consegue salvar semanas. Escolha uma frase longa.
# Defina também na Vercel e faça um novo deploy.
PLAN_EDIT_KEY=
# LAB_RACE_MODEL=claude-sonnet-5-5   # análise de cada prova (esforço baixo)
